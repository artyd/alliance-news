# ── MacroHarvey configuration ────────────────────────────────────────────────
# Copy to .env and fill in real values. NEVER commit the real .env.

# Postgres connection string, e.g. postgresql://user:pass@localhost:5432/news
DATABASE_URL=

# AI providers (OpenAI is primary, Gemini is the fallback)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Telegram bot
TELEGRAM_BOT_TOKEN=
# Comma-separated chat ids that receive scheduled reports / alerts
TELEGRAM_CHAT_ID=
# Public URL of the Mini App (served by this app at /webapp)
WEBAPP_URL=

# Parcel tracking
NOVA_POSHTA_API_KEY=
SEVENTEEN_TRACK_KEY=

# ── Security / ops (added during hardening) ──────────────────────────────────
# Require signed Telegram initData on /api/webapp/user/* and /track/* (default on).
# Set to 0 ONLY for local debugging.
TG_AUTH_REQUIRED=1
# Token required as ?token= on /generate_report|weekly|midday. Leave empty to
# leave those endpoints open (a warning is logged). Set a long random value in prod.
ADMIN_TOKEN=
# Comma-separated allowed CORS origins. Empty = allow all (no credentials).
ALLOWED_ORIGINS=
