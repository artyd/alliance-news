# Normalize line endings. The server is Linux — shell scripts and Python MUST
# use LF or they break (e.g. `bash deploy.sh` fails on CRLF).
* text=auto eol=lf

*.png binary
*.ttf binary
*.pdf binary

*.sh        text eol=lf
*.py        text eol=lf
*.service   text eol=lf
*.yml       text eol=lf
Caddyfile   text eol=lf
